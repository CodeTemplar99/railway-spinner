# Account or workspace token from https://railway.com/account/tokens
RAILWAY_API_TOKEN=

# Set to "project" if you use a project token instead (sent as Project-Access-Token)
# RAILWAY_TOKEN_KIND=project

# Project to manage containers in. On Railway this defaults to the app's own
# project (RAILWAY_PROJECT_ID is injected automatically), so only set it locally
# or to target a different project.
TARGET_PROJECT_ID=
# TARGET_ENVIRONMENT_ID=

# Shared password for the UI. Strongly recommended once deployed.
APP_PASSWORD=
